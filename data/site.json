  "highlights": [
    {
      "label": "PRIVACY-PRESERVING LEARNING",
      "name": "FDLDP",
      "title": "A better starting point for private learning.",
      "description": "A two-stage framework uses locally private reports to initialize a global model, then protects client updates during federated fine-tuning. The work studies the connection between privacy, convergence and communication.",
      "paper": "paper-14",
      "tags": [
        "Private pre-training",
        "Federated fine-tuning"
      ]
    },
    {
      "label": "ROBUST FEDERATED LEARNING",
      "name": "FedCleaner",
      "title": "Detect, then remove harmful influence.",
      "description": "A server-side defense combines proactive layer-wise anomaly detection with retroactive contribution erasure to address poisoned updates and their influence on the global model.",
      "paper": "paper-16",
      "tags": [
        "Anomaly detection",
        "Machine unlearning"
      ]
    },
    {
      "label": "LLM SECURITY",
      "name": "Prompt-in-Content",
      "title": "When uploaded content becomes an instruction.",
      "description": "This study examines adversarial prompts embedded in otherwise ordinary inputs, how they redirect model outputs, and why content isolation matters for safer LLM applications.",
      "paper": "paper-11",
      "tags": [
        "Uploaded inputs",
        "Output hijacking"
      ]
    }
  ],
